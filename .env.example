# Public Web Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=ediyrex@gmail.com
# NEXT_PUBLIC_CONTACT_PHONE=+91-00000-00000
NEXT_PUBLIC_STUDIO_LOCATION=India & Global

# Optional Privacy-First Analytics & Search Console Verification
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ediyrex.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token

# Backend / Database Configuration (Local PostgreSQL 18)
# DATABASE_URL=postgresql://postgres:root@localhost:5432/ediyrex_db
# SESSION_SECRET=replace-with-secure-random-secret
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Optional Cloudinary Media Storage (uses local fallback in public/uploads/cms when unset)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email Delivery (Resend API Key)
# RESEND_API_KEY=re_your_api_key_here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass

# Cloudflare Turnstile Bot Protection
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# Cloudflare R2 Object Storage (S3-Compatible)
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Sentry Error Monitoring & Performance Telemetry
# SENTRY_ORG=ediyrex
# SENTRY_PROJECT=website
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_...

# Cal.com Discovery Scheduling
# CAL_API_KEY=cal_live_...
# NEXT_PUBLIC_CAL_LINK=your-cal-username
# NEXT_PUBLIC_CAL_URL=https://cal.com/your-cal-username




